<h2>Database</h2>
<div class="statgrid">
  <div class="stat"><div class="num"><%= @total_albums %></div><div class="label">albums tracked</div></div>
  <div class="stat"><div class="num"><%= @scrape_runs %></div><div class="label">scrape runs</div></div>
  <div class="stat"><div class="num"><%= h(@oldest || '—') %></div><div class="label">oldest release</div></div>
  <div class="stat"><div class="num"><%= @last_scrape ? h(@last_scrape.to_s[0, 16]) : 'never' %></div><div class="label">last scrape</div></div>
</div>

<h2>Scores per profile</h2>
<table>
  <tr><th>Profile</th><th>Albums scored</th></tr>
  <% @per_profile.each do |row| %>
    <tr>
      <td class="artist"><a href="/p/<%= h row[:profile_name] %>" style="color: inherit; text-decoration: none;"><%= h row[:profile_name] %></a></td>
      <td><%= row[:count] %></td>
    </tr>
  <% end %>
</table>
